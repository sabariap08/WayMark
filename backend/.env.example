# WayMark backend configuration
# Copy to .env and edit. All values have safe defaults in config.py.

SECRET_KEY=waymark-dev-secret-change-me-please-32b
JWT_EXP_HOURS=72

# Supabase project
SUPABASE_URL=https://vzywehdyzzdiwbmtpwry.supabase.co
SUPABASE_KEY=sb_publishable_CF7Te9f7_bYke3SujOs-Dg_ZicAg2Pn

# Database (Postgres). Either provide DATABASE_URL (URI-encoded password!)
# or the individual parts below. The password contains "@", so if you write
# DATABASE_URL by hand encode it as %40.
# DATABASE_URL=postgresql+psycopg2://postgres:WayMark%40_2026@db.vzywehdyzzdiwbmtpwry.supabase.co:5432/postgres?sslmode=require
DB_HOST=db.vzywehdyzzdiwbmtpwry.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=WayMark@_2026

# If Postgres is unreachable (offline), fall back to a local SQLite file so
# the app still starts. Set to 0 to fail hard instead.
SQLITE_FALLBACK=1

# OTP settings. When SMTP is not configured the API returns a hardcoded
# fallback code made of zeros with OTP_LENGTH digits (e.g. 000000).
OTP_LENGTH=6
OTP_EXP_MINUTES=15

# SMTP (optional). Leave SMTP_HOST empty to keep mail in the in-app outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WayMark <no-reply@baymark.com>

# Demo user used when no token is supplied (frontend runs with
# REQUIRE_AUTH:false). Seeded automatically. Never an admin account.
DEMO_USER_EMAIL=user@baymark.com

# When 1 (the default) an unauthenticated request is resolved to DEMO_USER_EMAIL
# so the static frontend can browse without logging in. Set to 0 to require a
# real JWT everywhere — the test suite does this so anonymous calls are genuine
# 401s.
WM_DEMO_AUTH=1

# AI co-pilot. The default ("local") provider is a deterministic, offline
# generator in blueprints/ai.py — no key, no network. Set a provider + key to
# use a remote model; plans are ALWAYS proposals that a human must approve.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=

# Payments. Empty provider => payments are disabled and every checkout returns a
# clear 409 (no Payment row is created). "sandbox" enables the signature-verified
# sandbox flow: the server validates an HMAC-SHA256 signature
# (providerRef|registrationId|amountMinor) sent in the X-WayMark-Signature
# header. WayMark never accepts or stores card data.
PAYMENT_PROVIDER=
PAYMENT_MODE=test
PAYMENT_SECRET=waymark-dev-payment-secret-change-me