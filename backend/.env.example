# WayMark backend configuration
# Copy to .env and fill in your own values. NEVER commit the real .env file.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=
JWT_EXP_HOURS=72

# Supabase project (optional; only used if the application reads these values)
SUPABASE_URL=
SUPABASE_KEY=

# Local SQL Server (SSMS / Developer Edition). Set LOCAL_DB_ENABLED=1 to use it.
# Trusted_Connection=yes uses your Windows login; leave the user/password empty.
# Run backend/database.sql once to create the WayMarkLocal database and tables.
LOCAL_DB_ENABLED=0
LOCAL_DB_SERVER=localhost
LOCAL_DB_NAME=WayMarkLocal
LOCAL_DB_DRIVER=ODBC Driver 18 for SQL Server
LOCAL_DB_TRUSTED_CONNECTION=yes
LOCAL_DB_TRUST_SERVER_CERTIFICATE=yes
LOCAL_DB_USER=
LOCAL_DB_PASSWORD=

# Database (Postgres). Either provide DATABASE_URL (URI-encoded password!)
# or the individual parts below. When DB_HOST is empty the app uses a local
# SQLite file (backend/waymark-local.db) unless LOCAL_DB_ENABLED=1.
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# If the configured database is unreachable (offline), fall back to a local
# SQLite file so the app still starts. Set to 0 to fail hard instead.
SQLITE_FALLBACK=1
SQLITE_PATH=waymark-local.db

# OTP settings. When SMTP is not configured the API returns a hardcoded
# fallback code made of zeros with OTP_LENGTH digits (e.g. 000000).
OTP_LENGTH=6
OTP_EXP_MINUTES=15

# SMTP (optional). Leave SMTP_HOST empty to keep mail in the in-app outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=WayMark <no-reply@baymark.com>

# Demo user used when no token is supplied (frontend runs with
# REQUIRE_AUTH:false). Seeded automatically. Never an admin account.
DEMO_USER_EMAIL=user@baymark.com

# When 1 (the default) an unauthenticated request is resolved to DEMO_USER_EMAIL
# so the static frontend can browse without logging in. Set to 0 to require a
# real JWT everywhere — the test suite does this so anonymous calls are genuine
# 401s.
WM_DEMO_AUTH=1

# AI co-pilot. The default ("local") provider is a deterministic, offline
# generator in blueprints/ai.py — no key, no network. Set a provider + key to
# use a remote model; plans are ALWAYS proposals that a human must approve.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=

# Payments. Empty provider => payments are disabled and every checkout returns a
# clear 409 (no Payment row is created). "sandbox" enables the signature-verified
# sandbox flow: the server validates an HMAC-SHA256 signature
# (providerRef|registrationId|amountMinor) sent in the X-WayMark-Signature
# header. "paypal" enables the real PayPal Orders v2 integration below.
# WayMark never accepts or stores card data.
PAYMENT_PROVIDER=
PAYMENT_MODE=test
PAYMENT_SECRET=

# PayPal (developer.paypal.com > Apps & Credentials > Sandbox).
# Set PAYMENT_PROVIDER=paypal to turn on the PayPal checkout. The browser gets
# only the public client id; the secret stays on the server.
# Create a webhook pointing at /api/payments/paypal/webhook and paste its id.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# PayPal cannot settle in INR, so INR event fees are converted for checkout.
PAYPAL_INR_PER_USD=83.0
# Optional: where PayPal sends the payer back (defaults to the PayPal page).
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=